<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia tray application: wires the Windows adapter to the Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Bogopali.App</RootNamespace>
    <AssemblyName>bogopali</AssemblyName>
    <Product>bogopali</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bogopali.Core\Bogopali.Core.csproj" />
    <ProjectReference Include="..\Bogopali.Windows\Bogopali.Windows.csproj" />
  </ItemGroup>

</Project>
