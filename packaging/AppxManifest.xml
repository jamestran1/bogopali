<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build. build-release.ps1 replaces the $...$ tokens.
  Before the first Store submission, set PackageName and Publisher (build-release.ps1 parameters or the
  release workflow's repository variables) to the values Partner Center shows under Product identity.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="$PackageName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Architecture$" />

  <Properties>
    <DisplayName>bogopali</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Type Romanized Pali with diacritics in any Windows application.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="vi-vn" />
  </Resources>

  <Applications>
    <Application Id="bogopali" Executable="bogopali.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="bogopali"
        Description="Type Romanized Pali with diacritics in any Windows application."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- TaskId must match WindowsAutostart.StartupTaskId. -->
        <uap5:Extension Category="windows.startupTask" Executable="bogopali.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="BogopaliStartup" Enabled="false" DisplayName="bogopali" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
